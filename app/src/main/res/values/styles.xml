<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">



    <style name="textBottomNavigationActive">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="textBottomNavigationInActive">
        <item name="android:textSize">11sp</item>
    </style>


    <dimen name="h2TextSize">17dp</dimen>
    <dimen name="h3TextSize">22dp</dimen>
    <dimen name="h4TextSize">35dp</dimen>

    <style name="h2">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textColor">@color/g_gray700</item>
        <item name="android:textSize">@dimen/h2TextSize</item>
    </style>

    <style name="h3">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/h3TextSize</item>
    </style>
    <style name="h4">
        <item name="android:fontFamily">@font/poppins_thin</item>
        <item name="android:textColor">@color/g_black</item>
        <item name="android:textSize">@dimen/h4TextSize</item>
    </style>
    <style name="blueButtonStyle">
        <item name="android:background">@drawable/blue_btn_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/poppins_black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/h2TextSize</item>
    </style>
    <style name="whiteBtnStyle">
        <item name="android:background">@drawable/white_btn_bg</item>
        <item name="android:fontFamily">@font/poppins_black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/h2TextSize</item>
    </style>
   <style name="lightestBlueBtnBG">
       <item name="android:paddingVertical">2dp</item>
       <item name="android:paddingHorizontal">5dp</item>
       <item name="android:background">@drawable/lightest_blue_btn_bg</item>
       <item name="android:layout_marginStart">4dp</item>
       <item name="android:textAllCaps">false</item>
   </style>
    <style name="editText">
        <item name="android:background">@drawable/edt_white_bg</item>
        <item name="android:gravity">center</item>
        <item name="singleLine">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="DialogStyle" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="tabLayout_text" parent="TextAppearance.AppCompat">
        <item name="color">@color/black</item>
        <item name="fontFamily">@font/poppins_black</item>
        <item name="textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="SmallTextViewThin">
        <item name="android:textColor">@color/g_gray700</item>
        <item name="android:textSize">10sp</item>
        <item name="fontFamily">@font/poppins_thin</item>
    </style>
    <style name="MediumTextViewThin">
        <item name="android:textColor">#4b4f60</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/poppins_light</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BigTextViewThin">
        <item name="android:textColor">#4b4f60</item>
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">@font/poppins_thin</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
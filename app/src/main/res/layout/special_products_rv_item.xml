<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    android:elevation="10dp"
    android:id="@+id/cvMain"
    app:cardCornerRadius="5dp"
    android:backgroundTint="@color/white"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp">

        <ImageView
            android:id="@+id/iv_product_img"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_launcher_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_light"
            android:maxLines="2"
            android:text="@string/product_name"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iv_product_img"
            app:layout_constraintTop_toBottomOf="@id/iv_favourite_img_bg" />

        <TextView
            android:id="@+id/tv_product_price"
            android:text="@string/product_price"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tv_product_name"
            app:layout_constraintStart_toStartOf="@id/tv_product_name"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/iv_favourite_img_bg"
            android:backgroundTint="@color/g_light_red"
            android:layout_width="23dp"
            app:cardCornerRadius="5dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="23dp">
            <ImageView
                android:id="@+id/iv_favourite_img"
                android:src="@drawable/ic_favorite"
                android:layout_gravity="center"
                android:layout_width="10dp"
                android:layout_height="10dp"/>
        </androidx.cardview.widget.CardView>

        <com.github.leandroborgesferreira.loadingbutton.customViews.CircularProgressButton
            android:id="@+id/tv_add_to_cart"
            android:text="@string/add_to_cart"
            android:textSize="11sp"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/tv_product_price"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="@font/poppins_light"
            style="@style/blueButtonStyle"
            android:layout_width="77dp"
            android:layout_height="25dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
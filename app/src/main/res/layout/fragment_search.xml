<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    tools:context=".ui.shopping.fragment.bottomNavFragment.SearchFragment">

    <AutoCompleteTextView
        android:id="@+id/autoCompleteSearch"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="50dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="5dp"
        android:hint="@string/search"
        android:inputType="text"
        android:drawableRight="@drawable/ic_search"
        android:background="@drawable/et_bg_with_border"
        app:layout_constraintEnd_toStartOf="@+id/btnSearch"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSearch"
        style="@style/blueButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search"
        app:layout_constraintTop_toTopOf="@id/autoCompleteSearch"
        app:layout_constraintBottom_toBottomOf="@id/autoCompleteSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/autoCompleteSearch"
        tools:layout_editor_absoluteY="62dp" />
    <ProgressBar
        android:id="@+id/pb"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchedList"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/autoCompleteSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        tools:listitem="@layout/special_products_rv_item"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutNotFound"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="@id/rvSearchedList"
        app:layout_constraintEnd_toEndOf="@id/rvSearchedList"
        app:layout_constraintTop_toTopOf="@id/rvSearchedList"
        app:layout_constraintBottom_toBottomOf="@id/rvSearchedList"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <ImageView
            android:id="@+id/ivEmptyBoxTexture"
            android:src="@drawable/ic_empty_box_texture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/ivEmptyBoxBG"
            android:src="@drawable/ic_empty_box"
            android:background="@drawable/empty_box_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="@string/oop_not_found"
            android:textAllCaps="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivEmptyBoxTexture"
            android:layout_marginTop="20dp"
            android:textSize="17sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_black"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/vLine"
        android:background="@color/g_gray700"
        app:layout_constraintTop_toBottomOf="@id/rvSearchedList"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:id="@+id/tvDiscover"
        android:text="@string/discover_more"
        app:drawableLeftCompat="@drawable/ic_discover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vLine"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:drawablePadding="5dp"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDiscover"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnElectronics"
            android:text="@string/electronics"
            style="@style/lightestBlueBtnBG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCupboard"
            android:text="@string/cupboard"
            style="@style/lightestBlueBtnBG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChair"
            android:text="@string/chair"
            style="@style/lightestBlueBtnBG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFurniture"
            android:text="@string/furniture"
            style="@style/lightestBlueBtnBG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.shopping.fragment.OrderDetailsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/llStepView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="@id/guideline_v_0.96"
            app:layout_constraintStart_toStartOf="@id/guideline_v_0.04">

            <com.shuhart.stepview.StepView
                android:id="@+id/stepView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"

                app:sv_animationType="Line"

                app:sv_doneCircleColor="@color/g_orange_yellow"
                app:sv_doneCircleRadius="14dp"
                app:sv_doneStepLineColor="@color/g_orange_yellow"
                app:sv_doneStepMarkColor="@color/g_blue_gray200"
                app:sv_doneTextColor="@color/g_gray700"

                app:sv_selectedCircleColor="@color/g_orange_yellow"
                app:sv_selectedCircleRadius="14dp"
                app:sv_selectedStepNumberColor="@color/g_blue_gray200"
                app:sv_selectedTextColor="@color/g_gray700"

                app:sv_nextStepLineColor="@color/g_gray700"
                app:sv_nextTextColor="@color/g_gray700"

                app:sv_stepNumberTextSize="12sp"
                app:sv_stepLineWidth="3dp"
                app:sv_stepPadding="4dp"
                app:sv_stepViewStyle="@style/StepView"
                />

        </LinearLayout>
        <TextView
            android:id="@+id/tvShoppingAddress"
            android:text="@string/shopping_address"
            android:layout_marginTop="20dp"
            android:drawablePadding="5dp"
            app:layout_constraintStart_toStartOf="@id/guideline_v_0.04"
            app:layout_constraintTop_toBottomOf="@+id/llStepView"
            app:drawableStartCompat="@drawable/baseline_location_on_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:id="@+id/llShoppingAddress"
            app:layout_constraintStart_toStartOf="@id/guideline_v_0.04"
            app:layout_constraintEnd_toEndOf="@id/guideline_v_0.96"
            app:layout_constraintTop_toBottomOf="@+id/tvShoppingAddress"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvFullName"
                android:text="@string/full_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvAddress"
                android:text="@string/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvPhone"
                android:text="@string/phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <View
            android:id="@+id/HLine"
            app:layout_constraintStart_toStartOf="@id/guideline_v_0.04"
            app:layout_constraintEnd_toEndOf="@id/guideline_v_0.96"
            app:layout_constraintTop_toBottomOf="@id/llShoppingAddress"
            android:background="@color/g_gray700"
            android:layout_marginTop="20dp"
            android:layout_width="0dp"
            android:layout_height="1dp"/>
        <TextView
            android:id="@+id/tvProducts"
            app:drawableStartCompat="@drawable/ic_cart"
            android:drawablePadding="5dp"
            app:layout_constraintStart_toStartOf="@id/guideline_v_0.04"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/HLine"
            android:text="@string/products"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@id/guideline_v_0.96"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/guideline_v_0.04"
            app:layout_constraintTop_toBottomOf="@+id/tvProducts"
            tools:listitem="@layout/orders_details_rv_item" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/totalPriceContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="30dp"
            app:layout_constraintStart_toStartOf="@id/guideline_v_0.04"
            app:layout_constraintEnd_toEndOf="@id/guideline_v_0.96"
            app:layout_constraintTop_toBottomOf="@id/rvProducts"
            android:background="@drawable/total_price_container_bg">

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:fontFamily="@font/poppins_black"
                android:text="@string/total"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:fontFamily="@font/poppins_black"
                android:text="@string/_0"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_v_0.04"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.04" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_v_0.96"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.96" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
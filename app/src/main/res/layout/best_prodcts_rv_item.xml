<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="250dp"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="10dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/special_products_rv_item_bg">

   <ImageView
       android:id="@+id/ivProductImg"
       android:scaleType="fitXY"
       android:src="@drawable/ic_launcher_background"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toTopOf="parent"
       android:layout_width="130dp"
       android:layout_height="125dp"/>

   <TextView
       android:id="@+id/tvProductName"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:text="@string/cupboard"
       android:textColor="@color/black"
       android:textSize="14sp"
       android:textStyle="bold"
       app:layout_constraintEnd_toStartOf="@+id/ivFavourite"
       app:layout_constraintStart_toStartOf="@id/ivProductImg"
       app:layout_constraintTop_toBottomOf="@+id/ivProductImg" />
   <ImageView
       android:id="@+id/ivFavourite"
       android:src="@drawable/ic_favorite"
       app:layout_constraintEnd_toEndOf="@id/ivProductImg"
       app:layout_constraintTop_toBottomOf="@id/ivProductImg"
       android:layout_marginTop="12dp"
       app:tint="@color/g_blue_gray200"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"/>
   <TextView
       android:id="@+id/tvProductPrice"
       app:layout_constraintTop_toBottomOf="@+id/tvProductName"
       app:layout_constraintStart_toStartOf="@id/ivProductImg"
       android:layout_marginTop="5dp"
       android:text="@string/product_price"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"/>
   <TextView
       android:id="@+id/tvProductPriceWithDiscount"
       app:layout_constraintTop_toBottomOf="@+id/tvProductPrice"
       app:layout_constraintStart_toStartOf="@id/ivProductImg"
       android:layout_marginTop="5dp"
       android:text="@string/product_price"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>